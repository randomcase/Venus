    { "id": "fae",       "name": "The fae",            "desc": "Everything ×1.2, creatures need ×1.5; the fairy ring.", "effects": [ { "type": "unlock", "id": "fae" }, { "type": "mul", "target": "all", "x": 1.2 }, { "type": "mul", "target": "crewWater", "x": 1.5 } ] },
    { "id": "egyptian",  "name": "The house of Ma'at", "desc": "Te ×1.5, sayings cost ×0.8; the scales.", "effects": [ { "type": "unlock", "id": "egyptian" }, { "type": "mul", "target": "science", "x": 1.5 }, { "type": "mul", "target": "researchCost", "x": 0.8 } ] },
    { "id": "ox",        "name": "The ox",             "desc": "Slow, and it leaves soil. Soil ×1.5, meadow ×0.8; the ox.", "effects": [ { "type": "unlock", "id": "ox" }, { "type": "mul", "target": "res:soil", "x": 1.5 }, { "type": "mul", "target": "machine:meadow", "x": 0.8 } ] },
