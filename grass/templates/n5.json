{
  "title": "The First Blade",
  "tagline": "The ten thousand things. Still one blade to begin with; everything else follows if you let it.",
  "primary": "grass",
  "powerName": "sun",
  "tap": 3,
  "growth": 1.17,
  "offlineCap": 28800,
  "natural": { "grass": 0.15 },
  "stillness": { "max": 100, "regen": 0.8, "tapCost": 15, "floor": 0.2, "note": "Acting spends stillness. Everything that grows, grows at floor + (1 - floor) × stillness." },
  "day": { "length": 240, "night": 0.5, "dayName": "day", "nightName": "night" },
  "seasons": { "length": 480, "note": "Four seasons of 480 days. Each is a set of multipliers; the meadow does not argue with them.", "list": [
    { "id": "spring", "name": "Spring", "effects": [ { "type": "mul", "target": "machine:meadow", "x": 1.4 }, { "type": "mul", "target": "machine:sowing", "x": 1.5 } ] },
    { "id": "summer", "name": "Summer", "effects": [ { "type": "mul", "target": "machine:sky", "x": 1.3 }, { "type": "mul", "target": "decay", "x": 2 } ] },
    { "id": "autumn", "name": "Autumn", "effects": [ { "type": "mul", "target": "machine:seedhead", "x": 2 }, { "type": "mul", "target": "res:wood", "x": 1.3 } ] },
    { "id": "winter", "name": "Winter", "effects": [ { "type": "mul", "target": "machine:meadow", "x": 0.5 }, { "type": "mul", "target": "machine:sky", "x": 0.7 }, { "type": "mul", "target": "stillness", "x": 1.3 } ] } ] },
  "lift": { "name": "ground", "base": 900, "crewMass": 120 },
  "crew": { "name": "creatures", "start": 4, "lowMorale": 0.5, "needs": { "water": 0.004, "grass": 0.002 } },
  "ship": {
    "name": "The rains", "cadence": 584, "lock": 292, "cargo": 11400, "crewMass": 150,
    "plan": { "rain": 0.6, "crew": 0.1, "stone": 0.1, "wood": 0.1, "seed": 0.1 },
    "note": "The rains come when they come, every 584 days. The clouds gather 292 days before they break; what they carry is settled then. Rain, creatures, stone, wood, and seed from meadows you will never see."
  },
  "resources": [
    { "id": "grass",   "name": "grass",     "unit": "", "color": "#9ad36a", "start": 1,  "desc": "One blade, then the meadow." },
    { "id": "seed",    "name": "seed",      "unit": "", "color": "#e8d9a0", "start": 0,  "decay": 0.002, "desc": "Falls from the heads in autumn. Rots if it is not sown." },
    { "id": "soil",    "name": "soil",      "unit": "", "color": "#8a6a44", "start": 0,  "desc": "What grass becomes when it dies back." },
    { "id": "rain",    "name": "rain",      "unit": "", "color": "#9cc6e8", "start": 40, "desc": "Cannot be made. The sky gives it or does not." },
    { "id": "water",   "name": "water",     "unit": "", "color": "#5fb0e0", "start": 60, "cap": 400, "desc": "The ground holds only so much. Pools hold more." },
    { "id": "mist",    "name": "mist",      "unit": "", "color": "#d0dce8", "start": 0,  "decay": 0.02, "desc": "Comes at night, gone by mid-morning. Nets catch it; condensers keep it." },
    { "id": "wood",    "name": "wood",      "unit": "", "color": "#c9a06a", "start": 20, "desc": "From the grove." },
    { "id": "resin",   "name": "resin",     "unit": "", "color": "#e0a040", "start": 0,  "desc": "The pine's slow answer to a wound." },
    { "id": "stone",   "name": "stone",     "unit": "", "color": "#b8b8c0", "start": 10, "desc": "Uncarved." },
    { "id": "jade",    "name": "jade",      "unit": "", "color": "#5fb08a", "start": 0,  "desc": "Stone that the water polished until it changed its mind." },
    { "id": "clay",    "name": "clay",      "unit": "", "color": "#b07a5a", "start": 0,  "desc": "Soil and water, fired. Holds water that soil cannot." },
    { "id": "moss",    "name": "moss",      "unit": "", "color": "#4f7a4a", "start": 0,  "desc": "Grows on the stone where the water runs." },
    { "id": "honey",   "name": "honey",     "unit": "", "color": "#f2b03c", "start": 0,  "desc": "The hive's, on loan." },
    { "id": "crew",    "name": "creatures", "unit": "", "color": "#ffe1a8", "start": 4,  "desc": "Frogs, birds, deer, foxes, bees. They drink and graze, and some things need them." },
    { "id": "science", "name": "te",        "unit": "", "color": "#c8b8ff", "start": 0,  "desc": "Virtue: the power of the Way. Buys sayings." }
  ],
  "machines": [
    { "id": "meadow",    "sector": "blade",    "name": "The meadow spreads", "desc": "Let it.", "cost": { "grass": 15 }, "mass": 30, "draw": 15, "out": { "grass": 0.6 } },
    { "id": "sky",       "sector": "blade",    "name": "Open sky",           "desc": "Sun on the grass, half the day.", "cost": { "grass": 40 }, "mass": 10, "out": { "power": 100 }, "solar": true },
    { "id": "mulch",     "sector": "blade",    "name": "Dying back",         "desc": "Grass into soil.", "cost": { "grass": 150 }, "mass": 60, "draw": 80, "in": { "grass": 0.5 }, "out": { "soil": 0.25 } },
    { "id": "ground",    "sector": "blade",    "name": "Bare ground",        "desc": "+300 ground.", "cost": { "soil": 20 }, "mass": 15, "lift": 300 },
    { "id": "seedhead",  "sector": "blade",    "name": "Seed heads",         "desc": "Grass allowed to go over. Seed, which rots if you sit on it.", "cost": { "grass": 120 }, "mass": 40, "draw": 40, "in": { "grass": 0.3 }, "out": { "seed": 0.05 } },
    { "id": "sowing",    "sector": "two",      "name": "Sowing",             "desc": "Seed thrown by a creature that does not know it is sowing. Grass ×2.5 per seed.", "cost": { "grass": 400, "seed": 10 }, "mass": 60, "draw": 120, "crew": 1, "in": { "seed": 0.02 }, "out": { "grass": 2.5 } },
    { "id": "spring",    "sector": "water",    "name": "The spring",         "desc": "One of rain, nine of water.", "cost": { "grass": 500, "soil": 30 }, "mass": 120, "draw": 200, "in": { "rain": 0.01 }, "out": { "water": 0.09 } },
    { "id": "bend",      "sector": "water",    "name": "The river bends",    "desc": "+800 ground, and the river drinks a little rain.", "cost": { "soil": 60 }, "mass": 15, "lift": 800, "in": { "rain": 0.0005 } },
    { "id": "mistnet",   "sector": "water",    "name": "Mist net",           "desc": "Catches the night's mist. Gone by morning unless a condenser keeps it.", "cost": { "wood": 40 }, "mass": 30, "out": { "mist": 0.2 }, "night": true },
    { "id": "condenser", "sector": "water",    "name": "Condenser",          "desc": "Mist into water, before the sun takes it.", "cost": { "stone": 15, "wood": 60 }, "mass": 50, "draw": 100, "in": { "mist": 0.2 }, "out": { "water": 0.15 } },
    { "id": "pool",      "sector": "empty",    "name": "Clay pool",          "desc": "Holds 500 more water. Empty, and therefore useful.", "cost": { "clay": 30, "stone": 5 }, "mass": 80, "store": { "water": 500 } },
    { "id": "terrace",   "sector": "valley",   "name": "Terrace",            "desc": "+600 ground cut into the slope.", "cost": { "stone": 20, "soil": 100 }, "mass": 20, "lift": 600 },
    { "id": "mossbed",   "sector": "valley",   "name": "Wet stone",          "desc": "Moss, where the water runs over stone.", "cost": { "stone": 10 }, "mass": 20, "in": { "water": 0.01, "stone": 0.001 }, "out": { "moss": 0.02 } },
    { "id": "kiln",      "sector": "hub",      "name": "Kiln",               "desc": "Soil and water, fired. Clay.", "cost": { "grass": 900, "wood": 30 }, "mass": 150, "draw": 250, "in": { "soil": 0.3, "water": 0.05 }, "out": { "clay": 0.1 } },
    { "id": "grove",     "sector": "root",     "name": "The grove",          "desc": "Trees, in time. Birds carry the seed.", "cost": { "grass": 800, "soil": 80 }, "mass": 200, "draw": 300, "crew": 1, "in": { "water": 0.03 }, "out": { "wood": 0.05 } },
    { "id": "pinegrove", "sector": "root",     "name": "Pine grove",         "desc": "Slower. Resin.", "cost": { "grass": 1500, "seed": 30 }, "mass": 220, "draw": 300, "crew": 1, "in": { "water": 0.04 }, "out": { "resin": 0.02 } },
    { "id": "hive",      "sector": "root",     "name": "The hive",           "desc": "Bees, once there are three groves to fly between.", "cost": { "wood": 80 }, "mass": 30, "crew": 1, "in": { "grass": 0.2 }, "out": { "honey": 0.01 }, "needsMachine": { "id": "grove", "n": 3 } },
    { "id": "block",     "sector": "block",    "name": "The uncarved block", "desc": "Stone, unshaped.", "cost": { "grass": 5000, "soil": 300 }, "mass": 600, "draw": 1500, "crew": 2, "in": { "grass": 4 }, "out": { "stone": 0.03 } },
    { "id": "moon",      "sector": "block",    "name": "The moon pool",      "desc": "Holds the day's light and gives it back at night.", "cost": { "grass": 1200, "stone": 5 }, "mass": 150, "out": { "power": 250 }, "night": true, "requires": "moon" },
    { "id": "polish",    "sector": "wearing",  "name": "The river polishes", "desc": "Stone under water for long enough. Jade, occasionally.", "cost": { "stone": 80, "clay": 20 }, "mass": 120, "draw": 600, "in": { "stone": 0.05, "water": 0.02 }, "out": { "jade": 0.002 }, "needsMachine": { "id": "block", "n": 2 } },
    { "id": "reeds",     "sector": "soft",     "name": "Reeds",              "desc": "Bend and are not broken. A little sun, always.", "cost": { "grass": 2500, "stone": 8 }, "mass": 80, "out": { "power": 60 } },
    { "id": "bentpine",  "sector": "crooked",  "name": "The bent pine",      "desc": "Too crooked for the carpenter, so it lived. Sun from its shadow, somehow.", "cost": { "wood": 200, "resin": 10 }, "mass": 100, "out": { "power": 150 }, "requires": "bentpine" },
    { "id": "quietpool", "sector": "decrease", "name": "The quiet pool",     "desc": "Sit by it.", "cost": { "grass": 3000, "soil": 200, "stone": 10 }, "mass": 250, "draw": 400, "crew": 1, "out": { "science": 0.4 } },
    { "id": "teahouse",  "sector": "decrease", "name": "The teahouse",       "desc": "Honey in hot water and nothing to say.", "cost": { "wood": 300, "clay": 40 }, "mass": 200, "draw": 150, "crew": 1, "in": { "honey": 0.005, "water": 0.02 }, "out": { "science": 1.2 } },
    { "id": "path",      "sector": "journey",  "name": "The path",           "desc": "Wood laid down; feet wear the stone smooth.", "cost": { "grass": 8000, "stone": 20 }, "mass": 300, "draw": 200, "in": { "wood": 1 }, "out": { "stone": 0.02 } },
    { "id": "bridge",    "sector": "journey",  "name": "The bridge",         "desc": "+1200 ground on the far bank.", "cost": { "wood": 400, "stone": 60 }, "mass": 50, "lift": 1200 },
    { "id": "silence",   "sector": "nameless", "name": "Silence",            "desc": "Te, in quantity.", "cost": { "grass": 40000, "stone": 60 }, "mass": 500, "draw": 900, "crew": 2, "out": { "science": 2 } },
    { "id": "hut",       "sector": "country",  "name": "The hermit's hut",   "desc": "Moss on the roof, jade on the sill, honey in the jar.", "cost": { "wood": 800, "moss": 50, "jade": 2 }, "mass": 300, "crew": 1, "in": { "honey": 0.01 }, "out": { "science": 3 } },
    { "id": "hoard",     "sector": "blade",    "name": "The hoard",          "desc": "The dragon sleeps on what it keeps. +1500 ground.", "cost": { "stone": 40 }, "mass": 0, "lift": 1500, "requires": "dragon" },
    { "id": "breath",    "sector": "blade",    "name": "Dragon's breath",    "desc": "Warm through the night.", "cost": { "grass": 3000, "stone": 15 }, "mass": 100, "out": { "power": 200 }, "night": true, "requires": "dragon" },
    { "id": "longhouse", "sector": "blade",    "name": "The longhouse",      "desc": "They cut, they burn, and the grass comes back thicker.", "cost": { "wood": 100, "stone": 10 }, "mass": 200, "draw": 200, "in": { "wood": 0.5 }, "out": { "grass": 5 }, "requires": "viking" },
    { "id": "ring",      "sector": "blade",    "name": "The fairy ring",     "desc": "The grass inside grows wrong, and fast.", "cost": { "soil": 200 }, "mass": 40, "in": { "water": 0.02 }, "out": { "grass": 3 }, "requires": "fae" },
    { "id": "scales",    "sector": "blade",    "name": "The scales",         "desc": "Ma'at weighs. The feather is the measure.", "cost": { "stone": 30 }, "mass": 120, "draw": 300, "crew": 1, "out": { "science": 1.5 }, "requires": "egyptian" },
    { "id": "ox",        "sector": "blade",    "name": "The ox",             "desc": "Laozi rode west on one. It eats, and leaves soil.", "cost": { "seed": 40 }, "mass": 150, "in": { "grass": 0.8 }, "out": { "soil": 0.5 }, "requires": "ox" },
    { "id": "dream",     "sector": "blade",    "name": "The dream",          "desc": "Zhuangzi dreamt he was a butterfly. Mist into te.", "cost": { "mist": 20, "seed": 10 }, "mass": 10, "in": { "mist": 0.05 }, "out": { "science": 0.8 }, "requires": "butterfly" },
    { "id": "nest",      "sector": "blade",    "name": "The crane's nest",   "desc": "+400 ground on the high branch, and seed dropped from it.", "cost": { "wood": 60 }, "mass": 0, "lift": 400, "out": { "seed": 0.05 }, "requires": "crane" },
    { "id": "gourd",     "sector": "blade",    "name": "The gourd",          "desc": "Holds 800 water, and sweats a little.", "cost": { "seed": 20, "clay": 5 }, "mass": 20, "store": { "water": 800 }, "out": { "water": 0.02 }, "requires": "hermit" }
  ],
  "sectors": [
    { "id": "blade",     "name": "The first blade",               "role": "ch. 64", "built": true, "desc": "This is the shoot." },
    { "id": "two",       "name": "The two arise",                 "role": "ch. 2",  "cost": { "grass": 600 }, "desc": "Being and non-being create each other. Seed and grass. Sowing starts here; seed ×1.2.", "effects": [ { "type": "mul", "target": "res:seed", "x": 1.2 } ] },
    { "id": "water",     "name": "Water",                         "role": "ch. 8",  "cost": { "grass": 300, "soil": 20 }, "desc": "The highest good is like water." },
    { "id": "valley",    "name": "The valley spirit",             "role": "ch. 6",  "cost": { "soil": 150 }, "desc": "The low place everything runs to. Ground ×1.25.", "effects": [ { "type": "mul", "target": "lift", "x": 1.25 } ] },
    { "id": "hub",       "name": "The empty hub",                 "role": "ch. 11", "cost": { "grass": 2000, "soil": 100 }, "desc": "The hole makes the wheel useful. Everything ×1.25. The kiln starts here.", "effects": [ { "type": "mul", "target": "all", "x": 1.25 } ] },
    { "id": "empty",     "name": "Empty, and use it",             "role": "ch. 4",  "needs": ["hub", "water"], "cost": { "clay": 20, "grass": 2500 }, "desc": "The Way is empty and its use is never exhausted. Pools start here; water held ×1.2.", "effects": [ { "type": "mul", "target": "cap", "x": 1.2 } ] },
    { "id": "bellows",   "name": "The bellows",                   "role": "ch. 5",  "needs": ["hub"], "cost": { "wood": 100, "grass": 3000 }, "desc": "Empty yet inexhaustible; the more it moves the more it gives. Things need ×0.9 sun.", "effects": [ { "type": "mul", "target": "draw", "x": 0.9 } ] },
    { "id": "infant",    "name": "The infant",                    "role": "ch. 10", "needs": ["water"], "cost": { "water": 200, "grass": 1200 }, "desc": "Can you breathe like an infant? Creatures need ×0.9.", "effects": [ { "type": "mul", "target": "crewWater", "x": 0.9 } ] },
    { "id": "root",      "name": "Returning to the root",         "role": "ch. 16", "needs": ["water"], "cost": { "grass": 1500, "soil": 120, "crew": 2 }, "desc": "The ten thousand things rise and fall while the root stays. The groves start here." },
    { "id": "block",     "name": "The uncarved block",            "role": "ch. 28", "needs": ["root"], "cost": { "grass": 6000, "soil": 400, "crew": 4 }, "desc": "Left alone it becomes everything." },
    { "id": "wearing",   "name": "The soft wears the hard",       "role": "ch. 43", "needs": ["block", "empty"], "cost": { "stone": 100, "clay": 60, "crew": 4 }, "desc": "The softest thing rides over the hardest. Jade starts here." },
    { "id": "decrease",  "name": "Daily decrease",                "role": "ch. 48", "needs": ["root"], "cost": { "grass": 5000, "soil": 300, "crew": 3 }, "desc": "Every day something is dropped. Sayings cost ×0.9.", "effects": [ { "type": "mul", "target": "researchCost", "x": 0.9 } ] },
    { "id": "quiet",     "name": "Quiet the heart",               "role": "ch. 15", "needs": ["decrease"], "cost": { "honey": 5, "grass": 8000 }, "desc": "Who can wait quietly while the mud settles? Stillness returns ×1.2.", "effects": [ { "type": "mul", "target": "stillness", "x": 1.2 } ] },
    { "id": "abandon",   "name": "Abandon learning",              "role": "ch. 20", "needs": ["decrease"], "cost": { "grass": 12000, "jade": 1 }, "desc": "And end your troubles. Sayings cost ×0.85.", "effects": [ { "type": "mul", "target": "researchCost", "x": 0.85 } ] },
    { "id": "contentment","name": "Knowing enough",               "role": "ch. 33", "needs": ["quiet"], "cost": { "honey": 20, "moss": 20 }, "desc": "The one who knows enough is rich. Creatures need ×0.8.", "effects": [ { "type": "mul", "target": "crewWater", "x": 0.8 } ] },
    { "id": "soft",      "name": "The soft overcomes the hard",   "role": "ch. 78", "needs": ["root"], "cost": { "grass": 8000, "stone": 20, "crew": 4 }, "desc": "The weather reaches you half as hard.", "effects": [ { "type": "mul", "target": "storm", "x": 0.5 } ] },
    { "id": "crooked",   "name": "The crooked tree",              "role": "ch. 22", "needs": ["soft"], "cost": { "wood": 300, "resin": 5 }, "desc": "Bent, and therefore whole. Ground ×1.2. The bent pine starts here.", "effects": [ { "type": "mul", "target": "lift", "x": 1.2 } ] },
    { "id": "fewwords",  "name": "Nature speaks little",          "role": "ch. 23", "needs": ["soft"], "cost": { "grass": 15000, "moss": 10 }, "desc": "A gale does not last all morning. The weather reaches you ×0.7.", "effects": [ { "type": "mul", "target": "storm", "x": 0.7 } ] },
    { "id": "journey",   "name": "The thousand-li journey",       "role": "ch. 64", "needs": ["block", "root"], "cost": { "grass": 20000, "stone": 50, "crew": 5 }, "desc": "Begins beneath one's feet. The rains carry ×1.2.", "effects": [ { "type": "mul", "target": "cargo", "x": 1.2 } ] },
    { "id": "nameless",  "name": "The nameless",                  "role": "ch. 1",  "needs": ["journey"], "cost": { "grass": 60000, "stone": 150, "crew": 6 }, "desc": "Te ×1.5, sayings cost ×0.8.", "effects": [ { "type": "mul", "target": "science", "x": 1.5 }, { "type": "mul", "target": "researchCost", "x": 0.8 } ] },
    { "id": "country",   "name": "The small country",             "role": "ch. 80", "needs": ["nameless"], "cost": { "grass": 150000, "stone": 300, "jade": 3, "crew": 8 }, "desc": "Creatures travel light: 100 to a seat. The hermit's hut starts here.", "effects": [ { "type": "mul", "target": "crewMass", "x": 0.667 } ] },
    { "id": "unknown",   "name": "The unknown leader",            "role": "ch. 17", "needs": ["country"], "cost": { "jade": 5, "honey": 100 }, "desc": "The best leader is barely known. When the work is done the people say: we did it ourselves. Everything ×1.1.", "effects": [ { "type": "mul", "target": "all", "x": 1.1 } ] },
    { "id": "smallfish", "name": "Frying a small fish",           "role": "ch. 60", "needs": ["unknown"], "cost": { "grass": 300000, "jade": 8 }, "desc": "Govern a large country as you would fry a small fish: do not poke at it. The rains carry ×1.3.", "effects": [ { "type": "mul", "target": "cargo", "x": 1.3 } ] },
    { "id": "nothing",   "name": "Doing nothing",                 "role": "ch. 37", "needs": ["smallfish", "fewwords", "contentment"], "cost": { "grass": 1000000, "stone": 800, "jade": 12, "crew": 12 }, "desc": "The Tao does nothing, and nothing is left undone. Everything ×1.5. Opens the return.", "effects": [ { "type": "mul", "target": "all", "x": 1.5 } ] }
  ],
  "research": [
