      { "id": "water",     "name": "Like water",       "desc": "Water ×1.3, creatures need ×0.8.", "effects": [ { "type": "mul", "target": "res:water", "x": 1.3 }, { "type": "mul", "target": "crewWater", "x": 0.8 } ] },
      { "id": "valley",    "name": "The low place",    "desc": "Ground ×1.3.", "effects": [ { "type": "mul", "target": "lift", "x": 1.3 } ] },
      { "id": "block",     "name": "Uncarved",         "desc": "Everything ×1.15.", "effects": [ { "type": "mul", "target": "all", "x": 1.15 } ] },
      { "id": "stillness", "name": "Stillness",        "desc": "Stillness returns ×1.4.", "effects": [ { "type": "mul", "target": "stillness", "x": 1.4 } ] },
      { "id": "seed",      "name": "The seed",         "desc": "Seed ×1.5, sowing ×1.2, rot ×0.8.", "effects": [ { "type": "mul", "target": "res:seed", "x": 1.5 }, { "type": "mul", "target": "machine:sowing", "x": 1.2 }, { "type": "mul", "target": "decay", "x": 0.8 } ] },
      { "id": "jade",      "name": "The jade",         "desc": "Jade ×1.5, te ×1.2.", "effects": [ { "type": "mul", "target": "res:jade", "x": 1.5 }, { "type": "mul", "target": "science", "x": 1.2 } ] },
      { "id": "year",      "name": "The turning year", "desc": "Water held ×1.3, the rains carry ×1.2.", "effects": [ { "type": "mul", "target": "cap", "x": 1.3 }, { "type": "mul", "target": "cargo", "x": 1.2 } ] }
    ]
  },
  "becoming": {
    "note": "The transformation of things. Ring 1 is scripted: blade, flower, acorn, sapling, oak, grove. Then the oak drops an acorn, a tree stands, and the next ring is rolled from templates. There is no last form.",
    "seed": 64, "perForm": 0.05, "perRing": 0.25,
    "forms": [
      { "id": "blade",   "name": "the blade",   "shape": "blade",   "text": "nothing extra; it is the game you have", "when": { "total": { "grass": 1000 } } },
      { "id": "flower",  "name": "the flower",  "shape": "flower",  "text": "bees follow it: creatures arrive ×1.2 per rain", "when": { "total": { "grass": 20000 }, "res": { "science": 30 } }, "effects": [ { "type": "mul", "target": "crewMass", "x": 0.83 } ] },
      { "id": "acorn",   "name": "the acorn",   "shape": "acorn",   "text": "it waits: stillness returns ×1.5, everything ×0.8", "when": { "stillDays": 200 }, "effects": [ { "type": "mul", "target": "stillness", "x": 1.5 }, { "type": "mul", "target": "all", "x": 0.8 } ] },
      { "id": "sapling", "name": "the sapling", "shape": "sapling", "text": "+500 ground, meadow ×1.3", "when": { "total": { "grass": 1000000 }, "n": { "grove": 1 } }, "effects": [ { "type": "add", "target": "liftBase", "x": 500 }, { "type": "mul", "target": "machine:meadow", "x": 1.3 } ] },
      { "id": "oak",     "name": "the oak",     "shape": "oak",     "text": "it holds: creatures need ×0.6, the weather reaches you ×0.5", "when": { "total": { "grass": 100000000 }, "sectors": 6 }, "effects": [ { "type": "mul", "target": "crewWater", "x": 0.6 }, { "type": "mul", "target": "storm", "x": 0.5 } ] },
      { "id": "grove",   "name": "the grove",   "shape": "grove",   "text": "everything ×1.3; the oak's own acorns are ripening", "when": { "total": { "grass": 1000000000 }, "sectors": "all" }, "effects": [ { "type": "mul", "target": "all", "x": 1.3 } ] }
    ],
    "generator": {
      "formsPerRing": 6,
      "names": { "first": ["the bent", "the wet", "the late", "the unlit", "the low", "the patient", "the unnamed", "the useless", "the quiet", "the crooked", "the small", "the last"],
                 "plant": ["fern", "bramble", "lotus", "willow", "moss", "reed", "plum", "pine", "gourd", "thistle", "lichen", "sedge"] },
      "shapes": ["fern", "bramble", "lotus", "willow", "tuft", "reed", "blossom", "pine", "gourd", "thistle", "lichen", "sedge"],
      "passives": [
        { "text": "nothing rots while it stands",          "effects": [ { "type": "mul", "target": "decay", "x": 0.5 } ] },
        { "text": "it takes ground and gives it back",     "effects": [ { "type": "mul", "target": "lift", "x": 1.4 } ] },
        { "text": "it holds water",                        "effects": [ { "type": "mul", "target": "cap", "x": 1.5 } ] },
        { "text": "sitting near it is enough",             "effects": [ { "type": "mul", "target": "science", "x": 1.5 } ] },
        { "text": "it does not move and you stop moving",  "effects": [ { "type": "mul", "target": "stillness", "x": 1.6 } ] },
        { "text": "the creatures do its work for it",      "effects": [ { "type": "mul", "target": "crewNeed", "x": 0.6 } ] },
        { "text": "it is pale enough to see by",           "effects": [ { "type": "add", "target": "night", "x": 0.3 } ] },
        { "text": "the rains find it",                     "effects": [ { "type": "mul", "target": "cargo", "x": 1.3 } ] },
        { "text": "the meadow leans toward it",            "effects": [ { "type": "mul", "target": "machine:meadow", "x": 1.5 } ] },
        { "text": "it asks for nothing and gets it",       "effects": [ { "type": "mul", "target": "all", "x": 1.2 } ] }
      ],
      "threshold": { "base": 1000, "perForm": 12, "perRing": 3 },
      "twist": { "every": 3, "stillDays": 100, "text": "one form in three also asks for a quiet stretch: 100 days × ring without acting" }
    }
  },
  "forest": {
    "note": "One tree for every ring closed. Trees are never lost, not even by returning to the root. The reliable part.",
    "perTree": 0.02, "tierBonus": 0.1, "ground": 200, "natural": { "wood": 0.01 }, "none": "no trees yet",
    "tiers": [ { "at": 1, "name": "a tree" }, { "at": 3, "name": "a copse" }, { "at": 10, "name": "a wood" }, { "at": 30, "name": "a forest" }, { "at": 100, "name": "the old forest" }, { "at": 300, "name": "the forest that was here first" }, { "at": 1000, "name": "the ten thousand trees" } ]
  },
  "mycelium": {
    "note": "A tribute to mycelium.html: the web under the forest. Fed by everything that rots and by a tithe of the grass each time the mushrooms fruit. Depth climbs on a log scale, a thousandfold a step, and does not stop.",
    "every": 300, "tribute": 0.1, "perTree": 0.5, "fromDecay": true, "base": 1000, "growth": 1000, "perLevel": 0.1,
    "names": ["nothing yet", "threads", "a mat", "a web under the meadow", "the wood wide web", "a mind the size of the valley", "older than the forest", "the thing the forest grows on", "depth without a name"]
  },
  "avatar": {
    "note": "The first blade, yours. Nothing on it looks back. Every field is a template: add an option here and it appears in the builder and on the bank.",
    "fields": [
      { "id": "name",   "name": "Name",        "type": "text", "default": "The first blade" },
      { "id": "kind",   "name": "Kind",        "type": "choice", "options": ["meadow grass", "reed", "bamboo", "wheat", "sedge", "wild oat", "foxtail", "ryegrass", "rice", "millet"] },
      { "id": "height", "name": "Height (cm)", "type": "range", "min": 5, "max": 200, "default": 40 },
      { "id": "width",  "name": "Blade",       "type": "choice", "options": ["fine", "narrow", "broad", "flat"] },
      { "id": "green",  "name": "Green",       "type": "color", "options": ["#9ad36a", "#5fa84a", "#3f8a3a", "#b8d97a", "#7fc98a", "#c9d46a", "#4f7a4a", "#8fb56a"] },
      { "id": "tip",    "name": "Tip",         "type": "color", "options": ["#e8e0a0", "#f2c98a", "#c9d46a", "#b23a2a", "#f0f0f0", "#9ad36a"] },
      { "id": "lean",   "name": "Lean",        "type": "choice", "options": ["upright", "leaning", "bowed", "wind-bent"] },
      { "id": "head",   "name": "Seed head",   "type": "choice", "options": ["none", "wheat ear", "foxtail plume", "oat panicle", "reed plume", "seed tuft"] },
      { "id": "headColor", "name": "Head colour", "type": "color", "options": ["#e8d9a0", "#c9a06a", "#f2c98a", "#8a6a44", "#d0c0e0", "#f0f0f0"] },
      { "id": "dew",    "name": "Dew",         "type": "choice", "options": ["none", "a little", "heavy"] },
      { "id": "clump",  "name": "Clump",       "type": "choice", "options": ["one blade", "three", "five", "a tuft"] },
      { "id": "mood",   "name": "Wind",        "type": "choice", "options": ["still", "swaying", "restless"] },
      { "id": "root",   "name": "At the root", "type": "choice", "options": ["bare earth", "moss", "a snail shell", "a cowrie", "a pearl", "a whole lot of shells", "a smooth stone"] }
    ]
  }
